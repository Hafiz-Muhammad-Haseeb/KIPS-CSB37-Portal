DB_URL=jdbc:postgresql://HOST:5432/DATABASE
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_DRIVER=org.postgresql.Driver
SERVER_PORT=8080
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
FIELD_ENCRYPTION_KEY=REPLACE_WITH_A_SECURE_ENCRYPTION_KEY
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.pages.dev
UPLOAD_DIRECTORY=./private-uploads
BOOTSTRAP_ADMIN_USERNAME=YOUR_ADMIN_USERNAME
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_SECURE_PASSWORD
JWT_EXPIRATION_MINUTES=60
FLYWAY_ENABLED=true
